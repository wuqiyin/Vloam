---
import { locales, localeNames, localeTags, ogLocales, defaultLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const siteUrl = "https://vloam.com";
const canonicalPath = lang === defaultLocale ? "/" : `/${lang}/`;
const canonicalURL = new URL(canonicalPath, siteUrl);

const dbUrl = lang === defaultLocale ? "https://db.vloam.com/" : `https://db.vloam.com/${lang}/`;
const clipUrl = lang === defaultLocale ? "https://clip.vloam.com/" : `https://clip.vloam.com/${lang}/`;
const mermaidUrl = lang === defaultLocale ? "https://mermaid.vloam.com/" : `https://mermaid.vloam.com/${lang}/`;
const adhdUrl = lang === defaultLocale ? "https://adhdtest.vloam.com/" : `https://adhdtest.vloam.com/${lang}/`;
const bpdUrl = lang === defaultLocale ? "https://bdptest.vloam.com/" : `https://bdptest.vloam.com/${lang}/`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://vloam.com/#organization",
      "name": "Vloam",
      "url": "https://vloam.com",
      "logo": "https://vloam.com/favicon.svg",
      "description": t.meta.description,
      "sameAs": [
        dbUrl,
        clipUrl,
        mermaidUrl,
        adhdUrl,
        bpdUrl
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://vloam.com/#website",
      "url": canonicalURL.href,
      "name": "Vloam",
      "publisher": { "@id": "https://vloam.com/#organization" },
      "inLanguage": localeTags[lang]
    },
    {
      "@type": "SoftwareApplication",
      "name": "VloamDb",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS, Windows",
      "url": dbUrl,
      "description": t.products.db.desc
    },
    {
      "@type": "SoftwareApplication",
      "name": "VloamClip",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "macOS, Windows",
      "url": clipUrl,
      "description": t.products.clip.desc
    },
    {
      "@type": "WebApplication",
      "name": "Vloam Mermaid",
      "applicationCategory": "DesignApplication",
      "url": mermaidUrl,
      "description": t.products.mermaid.desc
    },
    {
      "@type": "WebApplication",
      "name": "ADHD Test",
      "applicationCategory": "HealthApplication",
      "url": adhdUrl,
      "description": t.products.adhd.desc
    },
    {
      "@type": "WebApplication",
      "name": "BPD Test",
      "applicationCategory": "HealthApplication",
      "url": bpdUrl,
      "description": t.products.bpd.desc
    },
    {
      "@type": "FAQPage",
      "mainEntity": t.faq.items.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<!doctype html>
<html lang={localeTags[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />

    <!-- Canonical & Multilingual Hreflang Alternates -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href="https://vloam.com/" />
    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={localeTags[l]}
        href={l === defaultLocale ? "https://vloam.com/" : `https://vloam.com/${l}/`}
      />
    ))}

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:site_name" content="Vloam" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {locales.filter(l => l !== lang).map(l => (
      <meta property="og:locale:alternate" content={ogLocales[l]} />
    ))}
    <meta property="og:image" content="https://vloam.com/favicon.svg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={t.meta.title} />
    <meta property="twitter:description" content={t.meta.description} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={lang === defaultLocale ? "/" : `/${lang}/`} class="brand">
          <img src="/favicon.svg" alt="Vloam Logo" width="32" height="32" />
          <span>Vloam</span>
        </a>

        <div class="header-right">
          <nav class="nav-links">
            <a href="#developer-tools">{t.nav.developerTools}</a>
            <a href="#assessment-tools">{t.nav.wellnessTools}</a>
            <a href="#values">{t.nav.philosophy}</a>
            <a href="#faq">{t.nav.faq}</a>
          </nav>

          <div class="lang-switch-wrapper">
            <select
              aria-label="Language Selector"
              class="lang-select"
              onchange="window.location.href = this.value"
            >
              {locales.map((l) => (
                <option
                  value={l === defaultLocale ? "/" : `/${l}/`}
                  selected={l === lang}
                >
                  {localeNames[l]}
                </option>
              ))}
            </select>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <div class="brand">
              <img src="/favicon.svg" alt="Vloam Logo" width="28" height="28" />
              <span>Vloam</span>
            </div>
            <p>{t.footer.brandDesc}</p>
          </div>
          <div class="footer-columns">
            <div class="footer-col">
              <h5>{t.footer.devTitle}</h5>
              <ul>
                <li><a href={dbUrl} target="_blank" rel="noopener">VloamDb (MySQL Client)</a></li>
                <li><a href={clipUrl} target="_blank" rel="noopener">VloamClip (Clipboard)</a></li>
                <li><a href={mermaidUrl} target="_blank" rel="noopener">Vloam Mermaid (Editor)</a></li>
                <li><a href={`${dbUrl}features/`} target="_blank" rel="noopener">VloamDb Features</a></li>
                <li><a href={`${dbUrl}alternatives/`} target="_blank" rel="noopener">Navicat / DataGrip Alt</a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h5>{t.footer.healthTitle}</h5>
              <ul>
                <li><a href={adhdUrl} target="_blank" rel="noopener">ADHD Assessment Test</a></li>
                <li><a href={bpdUrl} target="_blank" rel="noopener">BPD Screening Test</a></li>
                <li><a href={`${adhdUrl}about/`} target="_blank" rel="noopener">ADHD Clinical Criteria</a></li>
                <li><a href={`${bpdUrl}about/`} target="_blank" rel="noopener">BPD Assessment Scale</a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h5>{t.footer.legalTitle}</h5>
              <ul>
                <li><a href={`${dbUrl}privacy/`} target="_blank" rel="noopener">{t.footer.privacy}</a></li>
                <li><a href={`${dbUrl}terms/`} target="_blank" rel="noopener">{t.footer.terms}</a></li>
                <li><a href={`${dbUrl}about/`} target="_blank" rel="noopener">{t.footer.about}</a></li>
                <li><a href="mailto:support@vloam.com">{t.footer.contact}</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} Vloam. {t.footer.rights}</span>
          <span>{t.footer.motto}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
