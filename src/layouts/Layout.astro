---
import { locales, localeNames, localeTags, ogLocales, defaultLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/translations';

interface Props {
  lang?: Locale;
  title?: string;
  description?: string;
}

const { lang = defaultLocale, title, description } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;

const siteUrl = "https://vloam.com";

// Derive current page segment (e.g. '', 'about', 'security')
const pathname = Astro.url.pathname.replace(/^\/([a-z]{2}\/)?/, '').replace(/\/$/, '');
const pageSuffix = pathname ? `${pathname}/` : '';

const canonicalPath = lang === defaultLocale ? `/${pageSuffix}` : `/${lang}/${pageSuffix}`;
const canonicalURL = new URL(canonicalPath, siteUrl);

const dbUrl = lang === defaultLocale ? "https://db.vloam.com/" : `https://db.vloam.com/${lang}/`;
const clipUrl = lang === defaultLocale ? "https://clip.vloam.com/" : `https://clip.vloam.com/${lang}/`;
const mermaidUrl = lang === defaultLocale ? "https://mermaid.vloam.com/" : `https://mermaid.vloam.com/${lang}/`;
const adhdUrl = lang === defaultLocale ? "https://adhdtest.vloam.com/" : `https://adhdtest.vloam.com/${lang}/`;
const bpdUrl = lang === defaultLocale ? "https://bdptest.vloam.com/" : `https://bdptest.vloam.com/${lang}/`;
const kinkUrl = lang === defaultLocale ? "https://kinktest.vloam.com/" : `https://kinktest.vloam.com/${lang}/`;

const homeUrl = lang === defaultLocale ? "/" : `/${lang}/`;
const aboutUrl = lang === defaultLocale ? "/about/" : `/${lang}/about/`;
const securityUrl = lang === defaultLocale ? "/security/" : `/${lang}/security/`;
const articlesUrl = lang === defaultLocale ? "/articles/" : `/${lang}/articles/`;
const privacyUrl = lang === defaultLocale ? "/privacy/" : `/${lang}/privacy/`;
const termsUrl = lang === defaultLocale ? "/terms/" : `/${lang}/terms/`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://vloam.com/#organization",
      "name": "Vloam",
      "url": "https://vloam.com",
      "logo": "https://vloam.com/favicon.svg",
      "description": t.meta.description,
      "sameAs": [
        dbUrl,
        clipUrl,
        mermaidUrl,
        adhdUrl,
        bpdUrl,
        kinkUrl
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://vloam.com/#website",
      "url": canonicalURL.href,
      "name": "Vloam",
      "publisher": { "@id": "https://vloam.com/#organization" },
      "inLanguage": localeTags[lang]
    },
    {
      "@type": "SoftwareApplication",
      "name": "VloamDb",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS, Windows",
      "url": dbUrl,
      "description": t.products.db.desc
    },
    {
      "@type": "SoftwareApplication",
      "name": "VloamClip",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "macOS, Windows",
      "url": clipUrl,
      "description": t.products.clip.desc
    },
    {
      "@type": "WebApplication",
      "name": "Vloam Mermaid",
      "applicationCategory": "DesignApplication",
      "url": mermaidUrl,
      "description": t.products.mermaid.desc
    },
    {
      "@type": "WebApplication",
      "name": "ADHD Test",
      "applicationCategory": "HealthApplication",
      "url": adhdUrl,
      "description": t.products.adhd.desc
    },
    {
      "@type": "WebApplication",
      "name": "BPD Test",
      "applicationCategory": "HealthApplication",
      "url": bpdUrl,
      "description": t.products.bpd.desc
    },
    {
      "@type": "WebApplication",
      "name": "KinkTest",
      "applicationCategory": "HealthApplication",
      "url": kinkUrl,
      "description": t.products.kink.desc
    },
    {
      "@type": "FAQPage",
      "mainEntity": t.faq.items.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<!doctype html>
<html lang={localeTags[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />

    <!-- Canonical & Multilingual Hreflang Alternates -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={`https://vloam.com/${pageSuffix}`} />
    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={localeTags[l]}
        href={l === defaultLocale ? `https://vloam.com/${pageSuffix}` : `https://vloam.com/${l}/${pageSuffix}`}
      />
    ))}

    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:site_name" content="Vloam Labs" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {locales.filter(l => l !== lang).map(l => (
      <meta property="og:locale:alternate" content={ogLocales[l]} />
    ))}
    <meta property="og:image" content="https://vloam.com/favicon.svg" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDesc} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={homeUrl} class="brand">
          <img src="/favicon.svg" alt="Vloam Logo" width="32" height="32" />
          <span>Vloam</span>
        </a>

        <div class="header-right">
          <nav class="nav-links" id="siteNav">
            <a href={articlesUrl}>{t.nav.notes}</a>
            <a href={securityUrl}>{t.nav.security}</a>
            <a href={aboutUrl}>{t.nav.about}</a>
          </nav>

          <a
            href="https://github.com/wuqiyin/Vloam"
            target="_blank"
            rel="noopener noreferrer"
            class="header-github-link"
            aria-label="GitHub Repository"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>

          <div class="lang-switch-wrapper">
            <select
              aria-label="Language Selector"
              class="lang-select"
              onchange="window.location.href = this.value"
            >
              {locales.map((l) => (
                <option
                  value={l === defaultLocale ? `/${pageSuffix}` : `/${l}/${pageSuffix}`}
                  selected={l === lang}
                >
                  {localeNames[l]}
                </option>
              ))}
            </select>
          </div>

          <button
            class="mobile-menu-btn"
            id="mobileMenuBtn"
            type="button"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="siteNav"
          >
            <svg class="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <div class="brand">
              <img src="/favicon.svg" alt="Vloam Logo" width="28" height="28" />
              <span>Vloam</span>
            </div>
            <p>{t.footer.brandDesc}</p>
          </div>
          <div class="footer-columns">
            <div class="footer-col">
              <h5>{t.footer.devTitle}</h5>
              <ul>
                <li><a href={dbUrl} target="_blank" rel="noopener">VloamDb (MySQL Client)</a></li>
                <li><a href={clipUrl} target="_blank" rel="noopener">VloamClip (Clipboard)</a></li>
                <li><a href={`${dbUrl}features/`} target="_blank" rel="noopener">VloamDb Features</a></li>
                <li><a href={`${dbUrl}alternatives/`} target="_blank" rel="noopener">Navicat / DataGrip Alt</a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h5>{t.footer.healthTitle}</h5>
              <ul>
                <li><a href={mermaidUrl} target="_blank" rel="noopener">Vloam Mermaid (Editor)</a></li>
                <li><a href={adhdUrl} target="_blank" rel="noopener">ADHD Assessment Test</a></li>
                <li><a href={bpdUrl} target="_blank" rel="noopener">BPD Screening Test</a></li>
                <li><a href={kinkUrl} target="_blank" rel="noopener">KinkTest (Intimate Dynamics)</a></li>
                <li><a href={`${adhdUrl}about/`} target="_blank" rel="noopener">ADHD Clinical Criteria</a></li>
                <li><a href={`${bpdUrl}about/`} target="_blank" rel="noopener">BPD Assessment Scale</a></li>
              </ul>
            </div>
            <div class="footer-col">
              <h5>{t.footer.trustTitle}</h5>
              <ul>
                <li><a href={articlesUrl}>{t.nav.notes}</a></li>
                <li><a href={securityUrl}>{t.footer.security}</a></li>
                <li><a href={aboutUrl}>{t.footer.about}</a></li>
                <li><a href={privacyUrl}>{t.footer.privacy}</a></li>
                <li><a href={termsUrl}>{t.footer.terms}</a></li>
                <li><a href="mailto:support@vloam.com">{t.footer.contact}</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} Vloam Studio. {t.footer.rights}</span>
          <span>{t.footer.motto}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('mobileMenuBtn');
      const nav = document.getElementById('siteNav');
      if (btn && nav) {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = nav.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', String(isOpen));
        });

        document.addEventListener('click', (e) => {
          if (!nav.contains(e.target) && !btn.contains(e.target)) {
            nav.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
          }
        });

        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            nav.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>
