---
import Layout from '../layouts/Layout.astro';
import { defaultLocale } from '../i18n/config';
import { useTranslations } from '../i18n/translations';
import '../styles/global.css';

const t = useTranslations(defaultLocale);
---

<Layout lang={defaultLocale}>
  <div class="container article-page">
    <header class="article-header">
      <span class="section-label">Legal Terms</span>
      <h1>{t.termsPage.title}</h1>
      <p class="article-subtitle">{t.termsPage.subtitle}</p>
      <div class="article-date-meta">{t.termsPage.updatedDate}</div>
    </header>

    <div class="article-body">
      {t.termsPage.sections.map((sec) => (
        <section class="content-block">
          <h2>{sec.title}</h2>
          <p>{sec.content}</p>
          {sec.points && (
            <ul class="policy-points">
              {sec.points.map((pt) => (
                <li>
                  <span class="bullet-dot">›</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}

      <section class="content-block contact-block">
        <h3>Legal Contact</h3>
        <p>For questions or notices regarding these terms, please contact our legal desk at <a href="mailto:legal@vloam.com" class="text-primary font-bold">legal@vloam.com</a>.</p>
      </section>
    </div>
  </div>
</Layout>
