---
import Layout from '../layouts/Layout.astro';
import { defaultLocale } from '../i18n/config';
import { useTranslations } from '../i18n/translations';
import '../styles/global.css';

const t = useTranslations(defaultLocale);
---

<Layout lang={defaultLocale}>
  <div class="container article-page">
    <header class="article-header">
      <span class="section-label">Studio Transparency</span>
      <h1>{t.aboutPage.title}</h1>
      <p class="article-subtitle">{t.aboutPage.subtitle}</p>
    </header>

    <div class="article-body">
      <section class="content-block">
        <h2>{t.aboutPage.storyTitle}</h2>
        <p>{t.aboutPage.storyP1}</p>
        <p>{t.aboutPage.storyP2}</p>
      </section>

      <section class="content-block">
        <h2>{t.aboutPage.missionTitle}</h2>
        <p>{t.aboutPage.missionP1}</p>
      </section>

      <section class="content-block">
        <h2>{t.aboutPage.pillarsTitle}</h2>
        <div class="values-grid">
          <div class="value-card">
            <h3>{t.values.items.speedTitle}</h3>
            <p>{t.values.items.speedDesc}</p>
          </div>
          <div class="value-card">
            <h3>{t.values.items.privacyTitle}</h3>
            <p>{t.values.items.privacyDesc}</p>
          </div>
          <div class="value-card">
            <h3>{t.values.items.kbdTitle}</h3>
            <p>{t.values.items.kbdDesc}</p>
          </div>
        </div>
      </section>

      <section class="content-block contact-block">
        <h2>Contact &amp; Governance</h2>
        <p>Vloam is maintained by an independent group of engineers. Inquiries and partnerships can be directed to <a href="mailto:support@vloam.com" class="text-primary font-bold">support@vloam.com</a>.</p>
      </section>
    </div>
  </div>
</Layout>
