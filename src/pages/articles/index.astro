---
import Layout from '../../layouts/Layout.astro';
import { defaultLocale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import { articles } from '../../data/articles';
import '../../styles/global.css';

const t = useTranslations(defaultLocale);
const pageTitle = "Articles & Architectural Notes — Vloam Labs";
const pageDesc = "In-depth engineering essays on local-first computing, hardware secure enclaves, and client-side ephemeral sandboxing.";
---

<Layout lang={defaultLocale} title={pageTitle} description={pageDesc}>
  <div class="container article-page">
    <div class="article-breadcrumb">
      <a href="/">← Back to Vloam Labs</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">Articles</span>
    </div>

    <header class="article-header">
      <span class="section-label">Publications &amp; Insights</span>
      <h1>Articles &amp; Architectural Notes</h1>
      <p class="article-subtitle">
        Deep dives into local-first software architecture, hardware cryptographic enclaves, and the engineering ethics of zero-knowledge client sandboxing.
      </p>
    </header>

    <div class="articles-list">
      {articles.map((art) => (
        <article class="article-list-item">
          <div class="item-meta">
            <span class="item-category">{art.category}</span>
            <span class="meta-dot">·</span>
            <span class="item-date">{art.date}</span>
            <span class="meta-dot">·</span>
            <span class="item-read">{art.readTime}</span>
          </div>
          <h2 class="item-title">
            <a href={`/articles/${art.slug}/`}>{art.en.title}</a>
          </h2>
          <p class="item-lead">{art.en.description}</p>
          <div class="item-action">
            <a href={`/articles/${art.slug}/`} class="item-link">
              Read Essay &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>
  .article-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 2.25rem;
    font-family: var(--font-mono);
  }

  .article-breadcrumb a {
    color: var(--primary);
    transition: color 0.15s ease;
  }

  .article-breadcrumb a:hover {
    color: var(--primary-hover);
  }

  .breadcrumb-sep {
    opacity: 0.4;
  }

  .article-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .article-header h1 {
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0.75rem 0 1rem;
    color: var(--text-main);
  }

  .article-subtitle {
    font-size: 1.12rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 680px;
  }

  .articles-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .article-list-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 2.25rem;
    box-shadow: var(--card-shadow);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .article-list-item:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    box-shadow: var(--card-shadow-hover);
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--text-faint);
    margin-bottom: 0.85rem;
  }

  .item-category {
    color: var(--primary);
    font-weight: 600;
  }

  .meta-dot {
    opacity: 0.5;
  }

  .item-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.85rem;
    letter-spacing: -0.015em;
  }

  .item-title a {
    color: var(--text-main);
    transition: color 0.15s ease;
  }

  .item-title a:hover {
    color: var(--primary);
  }

  .item-lead {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .item-action {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .item-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
    transition: gap 0.15s ease, color 0.15s ease;
  }

  .item-link:hover {
    color: var(--primary-hover);
    gap: 0.55rem;
  }

  @media (max-width: 768px) {
    .article-list-item {
      padding: 1.35rem 1.15rem;
    }
    .item-title {
      font-size: 1.18rem;
    }
  }
</style>
