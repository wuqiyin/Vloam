---
import Layout from '../../layouts/Layout.astro';
import { prefixedLocales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import '../../styles/global.css';

export function getStaticPaths() {
  return prefixedLocales.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout lang={lang}>
  <div class="container article-page">
    <header class="article-header">
      <span class="section-label">{lang === 'zh' ? '工作室理念' : 'Studio Transparency'}</span>
      <h1>{t.aboutPage.title}</h1>
      <p class="article-subtitle">{t.aboutPage.subtitle}</p>
    </header>

    <div class="article-body">
      <section class="content-block">
        <h2>{t.aboutPage.storyTitle}</h2>
        <p>{t.aboutPage.storyP1}</p>
        <p>{t.aboutPage.storyP2}</p>
      </section>

      <section class="content-block">
        <h2>{t.aboutPage.missionTitle}</h2>
        <p>{t.aboutPage.missionP1}</p>
      </section>

      <section class="content-block">
        <h2>{t.aboutPage.pillarsTitle}</h2>
        <div class="values-grid">
          <div class="value-card">
            <h4>{t.values.items.speedTitle}</h4>
            <p>{t.values.items.speedDesc}</p>
          </div>
          <div class="value-card">
            <h4>{t.values.items.privacyTitle}</h4>
            <p>{t.values.items.privacyDesc}</p>
          </div>
          <div class="value-card">
            <h4>{t.values.items.kbdTitle}</h4>
            <p>{t.values.items.kbdDesc}</p>
          </div>
        </div>
      </section>

      <section class="content-block contact-block">
        <h3>{lang === 'zh' ? '联系与合作' : 'Contact & Governance'}</h3>
        <p>{lang === 'zh' ? 'Vloam 由独立工程师团队开发与维护。合作咨询与产品建议可直接发送邮件至' : 'Vloam is maintained by an independent group of engineers. Inquiries and partnerships can be directed to'} <a href="mailto:contact@vloam.com" class="text-primary font-bold">contact@vloam.com</a>。</p>
      </section>
    </div>
  </div>
</Layout>
