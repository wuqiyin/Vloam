---
import Layout from '../../layouts/Layout.astro';
import { prefixedLocales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/translations';
import '../../styles/global.css';

export function getStaticPaths() {
  return prefixedLocales.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const dbUrl = `https://db.vloam.com/${lang}/`;
const clipUrl = `https://clip.vloam.com/${lang}/`;
const mermaidUrl = `https://mermaid.vloam.com/${lang}/`;
const adhdUrl = `https://adhdtest.vloam.com/${lang}/`;
const bpdUrl = `https://bdptest.vloam.com/${lang}/`;

const securityUrl = `/${lang}/security/`;
---

<Layout lang={lang}>
  <div class="directory-page">
    <header class="directory-header">
      <div class="container">
        <span class="section-label">{t.nav.products}</span>
        <h1>{t.productsPage.title}</h1>
        <p class="directory-subtitle">{t.productsPage.subtitle}</p>
      </div>
    </header>

    <div class="container directory-body">
      <!-- Group 1: Native Desktop Applications -->
      <section class="dir-group">
        <div class="dir-group-header">
          <div class="dir-group-title">
            <span class="dir-group-badge">Desktop</span>
            <h2>{t.productsPage.desktopSectionTitle}</h2>
          </div>
          <p class="dir-group-desc">{t.productsPage.desktopSectionDesc}</p>
        </div>

        <div class="dir-list">
          <!-- VloamDb Entry -->
          <div class="dir-row" style="--accent-color: #3b82f6;">
            <div class="dir-app-col">
              <div class="dir-avatar db-avatar">Db</div>
              <div class="dir-app-info">
                <div class="dir-name-row">
                  <h3 class="dir-app-name">VloamDb</h3>
                  <span class="dir-ver-tag">v3.3.4</span>
                </div>
                <p class="dir-app-tagline">{t.products.db.slogan}</p>
              </div>
            </div>

            <div class="dir-meta-col">
              <div class="dir-chips-wrap">
                <span class="dir-chip">macOS (Silicon &amp; Intel)</span>
                <span class="dir-chip">Windows 10/11 x64</span>
              </div>
              <div class="dir-tech-sub">
                {lang === 'zh' ? 'Go 原生开发 · 钥匙串/DPAPI 安全区 · 0.5秒极速冷启动' : 'Go / Native · Keychain & DPAPI · Instant 0.5s cold start'}
              </div>
            </div>

            <div class="dir-action-col">
              <a href={dbUrl} target="_blank" rel="noopener" class="dir-cta-btn btn-blue">
                {t.products.db.cta}
              </a>
              <div class="dir-sub-links">
                <a href={`${dbUrl}features/`} target="_blank" rel="noopener">{lang === 'zh' ? '功能特性' : 'Features'}</a>
                <span class="sep">·</span>
                <a href={`${dbUrl}alternatives/`} target="_blank" rel="noopener">{lang === 'zh' ? '竞品对比' : 'Alternatives'}</a>
                <span class="sep">·</span>
                <a href={`${dbUrl}guides/`} target="_blank" rel="noopener">{lang === 'zh' ? '使用指南' : 'MySQL Guides'}</a>
              </div>
            </div>
          </div>

          <!-- VloamClip Entry -->
          <div class="dir-row" style="--accent-color: #10b981;">
            <div class="dir-app-col">
              <div class="dir-avatar clip-avatar">Clip</div>
              <div class="dir-app-info">
                <div class="dir-name-row">
                  <h3 class="dir-app-name">VloamClip</h3>
                  <span class="dir-ver-tag">v1.2.0</span>
                </div>
                <p class="dir-app-tagline">{t.products.clip.slogan}</p>
              </div>
            </div>

            <div class="dir-meta-col">
              <div class="dir-chips-wrap">
                <span class="dir-chip">macOS (Universal)</span>
                <span class="dir-chip">Windows 10/11 x64</span>
              </div>
              <div class="dir-tech-sub">
                {lang === 'zh' ? '先进先出/后进先出粘贴队列 · 毫秒级模糊搜索 · 本地 SQLite' : 'FIFO/LIFO Queues · Sub-ms Fuzzy Search · Local SQLite'}
              </div>
            </div>

            <div class="dir-action-col">
              <a href={clipUrl} target="_blank" rel="noopener" class="dir-cta-btn btn-emerald">
                {t.products.clip.cta}
              </a>
              <div class="dir-sub-links">
                <a href={`${clipUrl}features/`} target="_blank" rel="noopener">{lang === 'zh' ? '功能特性' : 'Features'}</a>
                <span class="sep">·</span>
                <a href={`${clipUrl}guides/`} target="_blank" rel="noopener">{lang === 'zh' ? '使用教程' : 'Guides'}</a>
                <span class="sep">·</span>
                <a href={`${clipUrl}changelog/`} target="_blank" rel="noopener">{lang === 'zh' ? '更新日志' : 'Changelog'}</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Group 2: Web Applications & Tools -->
      <section class="dir-group">
        <div class="dir-group-header">
          <div class="dir-group-title">
            <span class="dir-group-badge badge-web">Web Apps</span>
            <h2>{t.productsPage.webSectionTitle}</h2>
          </div>
          <p class="dir-group-desc">{t.productsPage.webSectionDesc}</p>
        </div>

        <div class="dir-list">
          <!-- Vloam Mermaid Entry -->
          <div class="dir-row" style="--accent-color: #06b6d4;">
            <div class="dir-app-col">
              <div class="dir-avatar mermaid-avatar">Mmd</div>
              <div class="dir-app-info">
                <div class="dir-name-row">
                  <h3 class="dir-app-name">Vloam Mermaid</h3>
                  <span class="dir-ver-tag">v1.1.0</span>
                </div>
                <p class="dir-app-tagline">{t.products.mermaid.slogan}</p>
              </div>
            </div>

            <div class="dir-meta-col">
              <div class="dir-chips-wrap">
                <span class="dir-chip">{lang === 'zh' ? '主流现代网页浏览器' : 'All Modern Web Browsers'}</span>
                <span class="dir-chip chip-free">{lang === 'zh' ? '100% 免费开放' : '100% Free'}</span>
              </div>
              <div class="dir-tech-sub">
                {lang === 'zh' ? '前端实时双向渲染 · 矢量 SVG / 高清 PNG 导出 · 零延迟' : 'Client-Side Island · Instant SVG/PNG Export · Zero Latency'}
              </div>
            </div>

            <div class="dir-action-col">
              <a href={mermaidUrl} target="_blank" rel="noopener" class="dir-cta-btn btn-cyan">
                {t.products.mermaid.cta}
              </a>
              <div class="dir-sub-links">
                <a href={`${mermaidUrl}editor/`} target="_blank" rel="noopener">{lang === 'zh' ? '在线画板' : 'Interactive Canvas'}</a>
                <span class="sep">·</span>
                <a href={`${mermaidUrl}docs/`} target="_blank" rel="noopener">{lang === 'zh' ? '语法速查' : 'Syntax Cheatsheet'}</a>
              </div>
            </div>
          </div>

          <!-- ADHD Test Entry -->
          <div class="dir-row" style="--accent-color: #f59e0b;">
            <div class="dir-app-col">
              <div class="dir-avatar adhd-avatar">ADHD</div>
              <div class="dir-app-info">
                <div class="dir-name-row">
                  <h3 class="dir-app-name">ADHD Test</h3>
                  <span class="dir-ver-tag">v2.1.0</span>
                </div>
                <p class="dir-app-tagline">{t.products.adhd.slogan}</p>
              </div>
            </div>

            <div class="dir-meta-col">
              <div class="dir-chips-wrap">
                <span class="dir-chip">{lang === 'zh' ? '移动端与桌面端通用' : 'Mobile & Desktop Web'}</span>
                <span class="dir-chip chip-free">{lang === 'zh' ? '10 国语言 · 免注册自查' : '10 Languages · Free'}</span>
              </div>
              <div class="dir-tech-sub">
                {lang === 'zh' ? '权威临床量表基准 · 纯前端内存打分 · 绝不留存答题记录' : 'Standardized Clinical Criteria · In-Memory Scoring · No Sign-Up'}
              </div>
            </div>

            <div class="dir-action-col">
              <a href={adhdUrl} target="_blank" rel="noopener" class="dir-cta-btn btn-amber">
                {t.products.adhd.cta}
              </a>
              <div class="dir-sub-links">
                <a href={`${adhdUrl}about/`} target="_blank" rel="noopener">{lang === 'zh' ? '量表常模背景' : 'Clinical Background'}</a>
                <span class="sep">·</span>
                <a href={`${adhdUrl}privacy/`} target="_blank" rel="noopener">{lang === 'zh' ? '隐私承诺' : 'Privacy Policy'}</a>
              </div>
            </div>
          </div>

          <!-- BPD Test Entry -->
          <div class="dir-row" style="--accent-color: #8b5cf6;">
            <div class="dir-app-col">
              <div class="dir-avatar bpd-avatar">BPD</div>
              <div class="dir-app-info">
                <div class="dir-name-row">
                  <h3 class="dir-app-name">BPD Test</h3>
                  <span class="dir-ver-tag">v2.1.0</span>
                </div>
                <p class="dir-app-tagline">{t.products.bpd.slogan}</p>
              </div>
            </div>

            <div class="dir-meta-col">
              <div class="dir-chips-wrap">
                <span class="dir-chip">{lang === 'zh' ? '移动端与桌面端通用' : 'Mobile & Desktop Web'}</span>
                <span class="dir-chip chip-free">{lang === 'zh' ? '10 国语言 · 免注册自查' : '10 Languages · Free'}</span>
              </div>
              <div class="dir-tech-sub">
                {lang === 'zh' ? '多维度特质分析 · 零服务端持久化 · 客观科普与就医参考' : 'Multi-Factor Analysis · Zero Server Storage · Educational Reference'}
              </div>
            </div>

            <div class="dir-action-col">
              <a href={bpdUrl} target="_blank" rel="noopener" class="dir-cta-btn btn-purple">
                {t.products.bpd.cta}
              </a>
              <div class="dir-sub-links">
                <a href={`${bpdUrl}about/`} target="_blank" rel="noopener">{lang === 'zh' ? '评估体系介绍' : 'Methodology'}</a>
                <span class="sep">·</span>
                <a href={`${bpdUrl}privacy/`} target="_blank" rel="noopener">{lang === 'zh' ? '数据保密规范' : 'Confidentiality'}</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Build Integrity & Security Notice Card -->
      <section class="dir-integrity-box">
        <div class="integrity-icon">🛡️</div>
        <div class="integrity-content">
          <h4>{t.productsPage.integrityTitle}</h4>
          <p>{t.productsPage.integrityDesc}</p>
          <div class="integrity-link">
            <a href={securityUrl}>
              {lang === 'zh' ? '阅读完整安全与本地隐私架构白皮书 →' : 'Read Full Security Architecture & Data Isolation Whitepaper →'}
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .directory-page {
    padding-bottom: 5rem;
  }

  .directory-header {
    padding: 4.5rem 0 3rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
    background: radial-gradient(circle at 50% 10%, rgba(37, 99, 235, 0.06) 0%, rgba(248, 250, 252, 0) 70%);
  }

  .directory-header h1 {
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0.5rem 0 0.85rem;
    color: var(--text-main);
  }

  .directory-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 640px;
    margin: 0 auto;
  }

  .directory-body {
    max-width: 1040px;
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .dir-group-header {
    margin-bottom: 1.5rem;
  }

  .dir-group-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .dir-group-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: rgba(37, 99, 235, 0.08);
    color: #1d4ed8;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .dir-group-badge.badge-web {
    background: rgba(5, 150, 105, 0.08);
    color: #047857;
    border-color: rgba(5, 150, 105, 0.2);
  }

  .dir-group-title h2 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.015em;
  }

  .dir-group-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .dir-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .dir-row {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.5rem 1.75rem;
    display: grid;
    grid-template-columns: 1.35fr 1.1fr auto;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
    box-shadow: var(--card-shadow);
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .dir-row::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent-color, var(--primary));
  }

  .dir-row:hover {
    border-color: #cbd5e1;
    background: #ffffff;
    box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.08), 0 0 0 1px var(--accent-color, #2563eb);
    transform: translateY(-2px);
  }

  .dir-app-col {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .dir-avatar {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 800;
    flex-shrink: 0;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .db-avatar { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
  .clip-avatar { background: linear-gradient(135deg, #10b981, #047857); }
  .mermaid-avatar { background: linear-gradient(135deg, #06b6d4, #0284c7); }
  .adhd-avatar { background: linear-gradient(135deg, #f59e0b, #d97706); font-size: 0.78rem; }
  .bpd-avatar { background: linear-gradient(135deg, #8b5cf6, #6d28d9); font-size: 0.78rem; }

  .dir-name-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .dir-app-name {
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .dir-ver-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-faint);
  }

  .dir-app-tagline {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .dir-meta-col {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .dir-chips-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .dir-chip {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--bg-subtle);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .dir-chip.chip-free {
    color: #047857;
    background: rgba(5, 150, 105, 0.08);
    border-color: rgba(5, 150, 105, 0.2);
  }

  .dir-tech-sub {
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .dir-action-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }

  .dir-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.25rem;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 600;
    color: #ffffff !important;
    background: var(--accent-color, var(--primary));
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 2px 8px -1px rgba(15, 23, 42, 0.15);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .dir-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px -2px rgba(15, 23, 42, 0.25);
    filter: brightness(1.08);
  }

  .btn-blue { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
  .btn-emerald { background: linear-gradient(135deg, #059669, #047857); }
  .btn-cyan { background: linear-gradient(135deg, #0284c7, #0369a1); }
  .btn-amber { background: linear-gradient(135deg, #d97706, #b45309); }
  .btn-purple { background: linear-gradient(135deg, #7c3aed, #6d28d9); }

  .dir-sub-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .dir-sub-links a {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .dir-sub-links a:hover {
    color: var(--primary);
    text-decoration: underline;
  }

  .dir-sub-links .sep {
    opacity: 0.4;
  }

  .dir-integrity-box {
    margin-top: 1rem;
    padding: 1.75rem 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--card-shadow);
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .integrity-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .integrity-content h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.4rem;
  }

  .integrity-content p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }

  .integrity-link a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--primary);
    transition: color 0.15s ease;
  }

  .integrity-link a:hover {
    color: var(--primary-hover);
  }

  @media (max-width: 900px) {
    .dir-row {
      grid-template-columns: 1fr;
      gap: 1.15rem;
      padding: 1.35rem 1.2rem;
    }

    .dir-row::before {
      top: 0;
      bottom: auto;
      left: 0;
      right: 0;
      height: 3px;
      width: 100%;
    }

    .dir-action-col {
      align-items: flex-start;
      padding-top: 0.85rem;
      border-top: 1px solid var(--border);
    }

    .dir-sub-links {
      flex-wrap: wrap;
    }

    .dir-integrity-box {
      padding: 1.35rem 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .directory-header {
      padding: 3rem 0 2rem;
    }

    .directory-header h1 {
      font-size: 1.8rem;
    }

    .directory-body {
      margin-top: 2rem;
      gap: 2.5rem;
    }
  }
</style>
