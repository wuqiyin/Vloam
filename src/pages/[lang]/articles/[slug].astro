---
import Layout from '../../../layouts/Layout.astro';
import { prefixedLocales, type Locale } from '../../../i18n/config';
import { articles } from '../../../data/articles';
import '../../../styles/global.css';

export function getStaticPaths() {
  const paths: { params: { lang: Locale; slug: string }; props: { lang: Locale; article: typeof articles[0] } }[] = [];
  
  for (const lang of prefixedLocales) {
    for (const article of articles) {
      paths.push({
        params: { lang, slug: article.slug },
        props: { lang, article },
      });
    }
  }

  return paths;
}

interface Props {
  lang: Locale;
  article: typeof articles[0];
}

const { lang, article } = Astro.props;
const localized = lang === 'zh' ? article.zh : article.en;

const siteUrl = "https://vloam.com";
const canonicalUrl = `${siteUrl}/${lang}/articles/${article.slug}/`;
const backHomeUrl = `/${lang}/`;
const backHomeText = lang === 'zh' ? '← 返回 Vloam Labs' : '← Back to Vloam Labs';

const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": localized.title,
  "description": localized.description,
  "datePublished": "2026-10-01",
  "dateModified": "2026-10-18",
  "inLanguage": lang === 'zh' ? 'zh-CN' : lang,
  "author": {
    "@type": "Organization",
    "name": "Vloam Labs",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "Vloam Labs",
    "logo": `${siteUrl}/favicon.svg`
  },
  "mainEntityOfPage": canonicalUrl
};
---

<Layout lang={lang} title={`${localized.title} — Vloam Labs`} description={localized.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />

  <article class="container article-page">
    <div class="article-breadcrumb">
      <a href={backHomeUrl}>{backHomeText}</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">{article.category}</span>
    </div>

    <header class="article-header">
      <div class="article-header-meta">
        <span class="article-tag">{article.category}</span>
        <span class="meta-dot">·</span>
        <span class="article-date">{article.date}</span>
        <span class="meta-dot">·</span>
        <span class="article-read">{article.readTime}</span>
      </div>
      <h1>{localized.title}</h1>
      <p class="article-lead">{localized.lead}</p>
    </header>

    <div class="article-body">
      {localized.sections.map((section) => (
        <section class="content-block">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </section>
      ))}

      <section class="content-block lab-box">
        <h3>{lang === 'zh' ? '关于 Vloam Labs 技术研究' : 'About Vloam Labs Engineering'}</h3>
        <p>
          {lang === 'zh' 
            ? 'Vloam Labs 是一家专注于轻量原生工具与纯前端沙盒环境的独立软件实验室。我们坚持零数据遥测、零云端上传与严格的数据主权。'
            : 'Vloam Labs is an independent studio developing lightweight, native tools and ephemeral, client-side web utilities. All tools are engineered with zero-telemetry and local-first data sovereignty.'
          }
        </p>
        <div class="lab-links">
          <a href={`${backHomeUrl}#developer-tools`}>
            {lang === 'zh' ? '查看原生桌面与 Web 工具矩阵 →' : 'Explore Native Software Matrix →'}
          </a>
          <a href={`/${lang}/security/`}>
            {lang === 'zh' ? '阅读安全架构与隐私隔离白皮书 →' : 'Read Security Architecture Whitepaper →'}
          </a>
        </div>
      </section>
    </div>
  </article>
</Layout>

<style>
  .article-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 2.25rem;
    font-family: var(--font-mono);
  }

  .article-breadcrumb a {
    color: #60a5fa;
    transition: color 0.15s ease;
  }

  .article-breadcrumb a:hover {
    color: #93c5fd;
  }

  .breadcrumb-sep {
    opacity: 0.4;
  }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .article-header-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    font-family: var(--font-mono);
    color: var(--text-faint);
    margin-bottom: 1.25rem;
  }

  .article-tag {
    color: #60a5fa;
    font-weight: 600;
  }

  .meta-dot {
    opacity: 0.5;
  }

  .article-header h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
    color: var(--text-main);
  }

  .article-lead {
    font-size: 1.15rem;
    color: #cbd5e1;
    line-height: 1.7;
    font-style: normal;
    border-left: 3px solid #3b82f6;
    padding-left: 1.25rem;
  }

  .article-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #e2e8f0;
  }

  .content-block {
    margin-bottom: 2.75rem;
  }

  .content-block h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 1rem;
    letter-spacing: -0.015em;
  }

  .content-block p {
    margin-bottom: 1.25rem;
    color: #cbd5e1;
  }

  .lab-box {
    margin-top: 3.5rem;
    padding: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .lab-box h3 {
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    color: var(--text-main);
  }

  .lab-box p {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .lab-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .lab-links a {
    color: #60a5fa;
  }

  .lab-links a:hover {
    color: #93c5fd;
  }
</style>
