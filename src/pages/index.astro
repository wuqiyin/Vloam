---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const faqItems = [
  {
    question: "What is Vloam?",
    answer: "Vloam is an independent software studio building high-performance, distraction-free desktop developer tools. We focus on native performance, clean ergonomics, and local-first data privacy for software engineers."
  },
  {
    question: "Do Vloam tools upload database credentials or clipboard contents to the cloud?",
    answer: "No. All Vloam tools (including VloamDb and VloamClip) are engineered with a strict local-first architecture. Database connection strings, passwords, query history, and clipboard contents stay exclusively on your local machine and never touch external cloud servers."
  },
  {
    question: "Which operating systems and processor architectures are supported?",
    answer: "Both VloamDb and VloamClip offer native desktop builds for macOS (Apple Silicon M1/M2/M3/M4 & Intel x86_64) and modern Windows (10/11 x64)."
  },
  {
    question: "What is the pricing model and trial policy?",
    answer: "Each tool provides a generous 15-day unrestricted full trial upon launch. After the trial period, users can unlock the software via a simple, affordable one-time purchase for perpetual lifetime access. There are no forced subscriptions or recurring fees."
  },
  {
    question: "How can I submit feature requests or report bugs?",
    answer: "We welcome developer feedback! You can reach our engineering team directly via email at support@vloam.com, or check out our public changelogs and community issue trackers."
  }
];
---

<Layout>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="badge">
        <span>✦</span> Developer Productivity Suite
      </div>
      <h1>Focused, Lightweight Developer Tools</h1>
      <p class="hero-subtitle">
        High-speed desktop utilities built with native ergonomics, low memory overhead, and local-first privacy. Designed for developers on macOS &amp; Windows.
      </p>
    </div>
  </section>

  <!-- Products Matrix Section -->
  <section id="products" class="products-section">
    <div class="container">
      <p class="section-label">Products</p>
      <h2 class="section-title">The Vloam Developer Toolset</h2>

      <div class="products-grid">
        <!-- VloamDb Card -->
        <article class="product-card" style="--card-accent: #3b82f6;">
          <div class="card-header">
            <span class="product-tag">Database Client</span>
            <span class="os-tag">macOS · Windows</span>
          </div>
          <h3>VloamDb</h3>
          <p class="product-slogan">The Fast, Focused MySQL Client for Developers</p>
          <p class="product-desc">
            A lightning-fast, keyboard-first MySQL GUI designed to eliminate the bloat of traditional tools. Features production safety guards, environment color tags, instant table fuzzy search, and local-first privacy.
          </p>

          <div class="features-list">
            <div class="feature-item">
              <span class="feature-icon">⚡</span>
              <div><strong>Instant Startup:</strong> Starts in under 0.5s with near-zero memory footprint. No Electron lag.</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🛡️</span>
              <div><strong>Production Safe Guard:</strong> Color-coded environment tags and dedicated read-only locks prevent accidental data destruction.</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">⌨️</span>
              <div><strong>Keyboard-First:</strong> Double-tap <code>Shift</code> for instant table switching, <code>Ctrl+F12</code> column navigation, and snippet expansion.</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🔒</span>
              <div><strong>Local-First Privacy:</strong> Database connection strings, credentials, and query histories remain safely on your hardware.</div>
            </div>
          </div>

          <div class="card-actions">
            <a href="https://db.vloam.com/" target="_blank" rel="noopener" class="btn-primary">
              Visit VloamDb Website &rarr;
            </a>
            <div class="deep-links">
              <a href="https://db.vloam.com/features/" target="_blank" rel="noopener">Features Overview</a>
              <a href="https://db.vloam.com/alternatives/" target="_blank" rel="noopener">Compare vs Navicat / DataGrip</a>
              <a href="https://db.vloam.com/guides/" target="_blank" rel="noopener">MySQL Guides</a>
              <a href="https://db.vloam.com/#pricing" target="_blank" rel="noopener">Pricing &amp; Trial</a>
            </div>
          </div>
        </article>

        <!-- VloamClip Card -->
        <article class="product-card clip-card" style="--card-accent: #8b5cf6;">
          <div class="card-header">
            <span class="product-tag">Clipboard &amp; Productivity</span>
            <span class="os-tag">macOS · Windows</span>
          </div>
          <h3>VloamClip</h3>
          <p class="product-slogan">Local-First Clipboard Manager with FIFO/LIFO Queue</p>
          <p class="product-desc">
            A modern, distraction-free desktop clipboard manager. Streamline repetitive data entry, multi-step code refactoring, and daily multitasking with sequential multi-item copy and ordered paste queues.
          </p>

          <div class="features-list">
            <div class="feature-item">
              <span class="feature-icon">📋</span>
              <div><strong>FIFO / LIFO Paste Queue:</strong> Copy multiple code snippets or form values in sequence and paste them one by one automatically.</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🔍</span>
              <div><strong>Instant Fuzzy Search:</strong> Sub-millisecond full-text history search across plain text, formatted code, and URLs.</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">⭐</span>
              <div><strong>Pinned Favorites:</strong> Organize reusable shell commands, frequent SQL snippets, and templates that persist forever.</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🔐</span>
              <div><strong>Zero Cloud Tracking:</strong> 100% on-device storage. No external telemetry or cloud sync on sensitive clipboard data.</div>
            </div>
          </div>

          <div class="card-actions">
            <a href="https://clip.vloam.com/" target="_blank" rel="noopener" class="btn-primary btn-purple">
              Visit VloamClip Website &rarr;
            </a>
            <div class="deep-links">
              <a href="https://clip.vloam.com/features/" target="_blank" rel="noopener">Features</a>
              <a href="https://clip.vloam.com/guides/" target="_blank" rel="noopener">Usage Guides</a>
              <a href="https://clip.vloam.com/changelog/" target="_blank" rel="noopener">Changelog</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section id="values" class="values-section">
    <div class="container">
      <p class="section-label">Philosophy</p>
      <h2 class="section-title">Built for Developer Flow</h2>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">⚡</div>
          <h4>Peak Performance</h4>
          <p>We refuse bloated runtimes that consume gigabytes of memory for simple tasks. Vloam tools start instantly and run quietly in the background.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">🛡️</div>
          <h4>Strict Local-First Privacy</h4>
          <p>Your database credentials and clipboard history represent sensitive intellectual property. They belong strictly on your local device, never on third-party servers.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">⌨️</div>
          <h4>Keyboard-Driven Ergonomics</h4>
          <p>Carefully mapped shortcuts, fuzzy command pickers, and intuitive navigation allow developers to stay in deep flow without reaching for the mouse.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="faq-section">
    <div class="container">
      <p class="section-label">Questions &amp; Answers</p>
      <h2 class="section-title">Frequently Asked Questions</h2>

      <div class="faq-list">
        {faqItems.map(item => (
          <div class="faq-item">
            <h4>{item.question}</h4>
            <p>{item.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
