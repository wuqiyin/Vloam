---
import Layout from '../layouts/Layout.astro';
import SpecsTable from './SpecsTable.astro';
import ReleaseRadar from './ReleaseRadar.astro';
import EngineeringNotes from './EngineeringNotes.astro';
import SecurityPillars from './SecurityPillars.astro';
import { getLang, defaultLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = getLang(Astro.currentLocale) } = Astro.props;
const t = useTranslations(lang);

const dbUrl = lang === defaultLocale ? "https://db.vloam.com/" : `https://db.vloam.com/${lang}/`;
const clipUrl = lang === defaultLocale ? "https://clip.vloam.com/" : `https://clip.vloam.com/${lang}/`;
const mermaidUrl = lang === defaultLocale ? "https://mermaid.vloam.com/" : `https://mermaid.vloam.com/${lang}/`;
const adhdUrl = lang === defaultLocale ? "https://adhdtest.vloam.com/" : `https://adhdtest.vloam.com/${lang}/`;
const bpdUrl = lang === defaultLocale ? "https://bdptest.vloam.com/" : `https://bdptest.vloam.com/${lang}/`;

const securityPageUrl = lang === defaultLocale ? "/security/" : `/${lang}/security/`;

const trustPillarsMap: Record<string, { icon: string; title: string; desc: string }[]> = {
  zh: [
    { icon: '⚡', title: '原生底层架构', desc: '零冗余开销' },
    { icon: '🛡️', title: '离线优先设计', desc: '100% 数据不离机' },
    { icon: '🚀', title: '毫秒极速响应', desc: '开箱即用' },
    { icon: '🔒', title: '零知识安全隔离', desc: '无遥测无埋点' }
  ],
  en: [
    { icon: '⚡', title: 'Native Architecture', desc: 'Zero Electron Bloat' },
    { icon: '🛡️', title: 'Offline-First Storage', desc: '100% On-Device' },
    { icon: '🚀', title: 'Instant Cold Launch', desc: 'Sub-second Startup' },
    { icon: '🔒', title: 'Zero Telemetry', desc: 'No Cloud Tracking' }
  ],
  es: [
    { icon: '⚡', title: 'Arquitectura Nativa', desc: 'Cero Bloatware' },
    { icon: '🛡️', title: 'Offline-First', desc: '100% Local' },
    { icon: '🚀', title: 'Inicio Instantáneo', desc: 'Milisegundos' },
    { icon: '🔒', title: 'Cero Telemetría', desc: 'Sin Rastreo' }
  ],
  fr: [
    { icon: '⚡', title: 'Architecture Native', desc: 'Zéro Bloatware' },
    { icon: '🛡️', title: 'Stockage Local', desc: '100% Sur Machine' },
    { icon: '🚀', title: 'Lancement Éclair', desc: 'Sous la seconde' },
    { icon: '🔒', title: 'Zéro Télémétrie', desc: 'Confidentialité Totale' }
  ],
  de: [
    { icon: '⚡', title: 'Native Architektur', desc: 'Kein Ballast' },
    { icon: '🛡️', title: 'Offline-First', desc: '100% Lokal' },
    { icon: '🚀', title: 'Blitzstart', desc: 'Millisekundenschnell' },
    { icon: '🔒', title: 'Null Telemetrie', desc: 'Privat & Sicher' }
  ],
  pt: [
    { icon: '⚡', title: 'Arquitetura Nativa', desc: 'Zero Bloatware' },
    { icon: '🛡️', title: 'Offline-First', desc: '100% Local' },
    { icon: '🚀', title: 'Início Instantâneo', desc: 'Milissegundos' },
    { icon: '🔒', title: 'Zero Telemetria', desc: 'Sem Rastreamento' }
  ],
  it: [
    { icon: '⚡', title: 'Architettura Nativa', desc: 'Zero Bloatware' },
    { icon: '🛡️', title: 'Offline-First', desc: '100% Locale' },
    { icon: '🚀', title: 'Avvio Istantaneo', desc: 'Millisecondi' },
    { icon: '🔒', title: 'Zero Telemetria', desc: 'Nessun Tracciamento' }
  ],
  nl: [
    { icon: '⚡', title: 'Native Architectuur', desc: 'Geen Bloatware' },
    { icon: '🛡️', title: 'Offline-First', desc: '100% Lokaal' },
    { icon: '🚀', title: 'Bliksemstart', desc: 'Milliseconden' },
    { icon: '🔒', title: 'Geen Telemetrie', desc: 'Volledig Privé' }
  ],
  pl: [
    { icon: '⚡', title: 'Natywna Architektura', desc: 'Zero Narzutu' },
    { icon: '🛡️', title: 'Offline-First', desc: '100% Lokalnie' },
    { icon: '🚀', title: 'Błyskawiczny Start', desc: 'Milisekundy' },
    { icon: '🔒', title: 'Zero Telemetrii', desc: 'Prywatność' }
  ],
  ro: [
    { icon: '⚡', title: 'Arhitectură Nativă', desc: 'Fără Încărcare' },
    { icon: '🛡️', title: 'Offline-First', desc: '100% Pe Dispozitiv' },
    { icon: '🚀', title: 'Pornire Instantanee', desc: 'Milisecunde' },
    { icon: '🔒', title: 'Zero Telemetrie', desc: 'Fără Urmărire' }
  ]
};

const trustPillars = trustPillarsMap[lang] || trustPillarsMap.en;
---

<Layout lang={lang}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="badge">
        <span class="badge-dot"></span>
        <span>{t.hero.badge}</span>
      </div>
      <h1>{t.hero.title}</h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>

      <div class="hero-trust-strip">
        {trustPillars.map(p => (
          <div class="trust-item">
            <span>{p.icon}</span>
            <div><strong>{p.title}</strong> · {p.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Developer Tools Section -->
  <section id="developer-tools" class="products-section">
    <div class="container">
      <div class="section-header-wrap">
        <p class="section-label">{lang === 'zh' ? '原生桌面应用' : 'Desktop Applications'}</p>
        <h2 class="section-title">{t.categories.developerTools}</h2>
        <p class="category-subtitle">{t.categories.developerSubtitle}</p>
      </div>

      <div class="products-grid two-col">
        <!-- VloamDb Card -->
        <article class="product-card" style="--card-accent: #2563eb;">
          <div class="card-header">
            <span class="product-tag">{t.products.db.tag}</span>
            <span class="os-tag">{t.products.db.badge}</span>
          </div>

          <div class="card-identity">
            <div class="app-icon-squircle" style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
              </svg>
            </div>
            <div>
              <h3>{t.products.db.title}</h3>
              <p class="product-slogan blue-slogan">{t.products.db.slogan}</p>
            </div>
          </div>

          <p class="product-desc">{t.products.db.desc}</p>

          <div class="features-list">
            {t.products.db.features.map(f => (
              <div class="feature-item">
                <span class="feature-icon-box">{f.icon}</span>
                <div><strong>{f.title}</strong> {f.desc}</div>
              </div>
            ))}
          </div>

          <div class="card-actions">
            <a href={dbUrl} target="_blank" rel="noopener" class="btn-primary">
              <span>{t.products.db.cta}</span>
              <span>→</span>
            </a>
            <div class="deep-links">
              <a href={`${dbUrl}features/`} target="_blank" rel="noopener">Features</a>
              <a href={`${dbUrl}alternatives/`} target="_blank" rel="noopener">Navicat &amp; DataGrip Alt</a>
              <a href={`${dbUrl}guides/`} target="_blank" rel="noopener">MySQL Guides</a>
            </div>
          </div>
        </article>

        <!-- VloamClip Card -->
        <article class="product-card" style="--card-accent: #059669;">
          <div class="card-header">
            <span class="product-tag">{t.products.clip.tag}</span>
            <span class="os-tag">{t.products.clip.badge}</span>
          </div>

          <div class="card-identity">
            <div class="app-icon-squircle" style="background: linear-gradient(135deg, #10b981 0%, #047857 100%);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                <path d="m11 11 3 3-5 5"></path>
              </svg>
            </div>
            <div>
              <h3>{t.products.clip.title}</h3>
              <p class="product-slogan emerald-slogan">{t.products.clip.slogan}</p>
            </div>
          </div>

          <p class="product-desc">{t.products.clip.desc}</p>

          <div class="features-list">
            {t.products.clip.features.map(f => (
              <div class="feature-item">
                <span class="feature-icon-box">{f.icon}</span>
                <div><strong>{f.title}</strong> {f.desc}</div>
              </div>
            ))}
          </div>

          <div class="card-actions">
            <a href={clipUrl} target="_blank" rel="noopener" class="btn-primary btn-emerald">
              <span>{t.products.clip.cta}</span>
              <span>→</span>
            </a>
            <div class="deep-links">
              <a href={`${clipUrl}features/`} target="_blank" rel="noopener">Features</a>
              <a href={`${clipUrl}guides/`} target="_blank" rel="noopener">Usage Guides</a>
              <a href={`${clipUrl}changelog/`} target="_blank" rel="noopener">Release Notes</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Assessment Tools Section -->
  <section id="assessment-tools" class="products-section alt-bg">
    <div class="container">
      <div class="section-header-wrap">
        <p class="section-label">{lang === 'zh' ? '免安装 Web 矩阵' : 'Browser Utilities'}</p>
        <h2 class="section-title">{t.categories.assessmentTools}</h2>
        <p class="category-subtitle">{t.categories.assessmentSubtitle}</p>
      </div>

      <div class="products-grid three-col">
        <!-- Vloam Mermaid Card -->
        <article class="product-card" style="--card-accent: #0284c7;">
          <div class="card-header">
            <span class="product-tag">{t.products.mermaid.tag}</span>
            <span class="os-tag">{t.products.mermaid.badge}</span>
          </div>

          <div class="card-identity">
            <div class="app-icon-squircle" style="background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="6" height="6" rx="1"></rect>
                <rect x="15" y="15" width="6" height="6" rx="1"></rect>
                <path d="M6 9v3a3 3 0 0 0 3 3h6"></path>
                <path d="m15 12 3 3-3 3"></path>
              </svg>
            </div>
            <div>
              <h3>{t.products.mermaid.title}</h3>
              <p class="product-slogan cyan-slogan">{t.products.mermaid.slogan}</p>
            </div>
          </div>

          <p class="product-desc">{t.products.mermaid.desc}</p>

          <div class="features-list">
            {t.products.mermaid.features.map(f => (
              <div class="feature-item">
                <span class="feature-icon-box">{f.icon}</span>
                <div><strong>{f.title}</strong> {f.desc}</div>
              </div>
            ))}
          </div>

          <div class="card-actions">
            <a href={mermaidUrl} target="_blank" rel="noopener" class="btn-primary btn-cyan">
              <span>{t.products.mermaid.cta}</span>
              <span>→</span>
            </a>
          </div>
        </article>

        <!-- ADHD Test Card -->
        <article class="product-card" style="--card-accent: #d97706;">
          <div class="card-header">
            <span class="product-tag">{t.products.adhd.tag}</span>
            <span class="os-tag">{t.products.adhd.badge}</span>
          </div>

          <div class="card-identity">
            <div class="app-icon-squircle" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"></circle>
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="2" x2="12" y2="4"></line>
                <line x1="12" y1="20" x2="12" y2="22"></line>
                <line x1="2" y1="12" x2="4" y2="12"></line>
                <line x1="20" y1="12" x2="22" y2="12"></line>
              </svg>
            </div>
            <div>
              <h3>{t.products.adhd.title}</h3>
              <p class="product-slogan amber-slogan">{t.products.adhd.slogan}</p>
            </div>
          </div>

          <p class="product-desc">{t.products.adhd.desc}</p>

          <div class="features-list">
            {t.products.adhd.features.map(f => (
              <div class="feature-item">
                <span class="feature-icon-box">{f.icon}</span>
                <div><strong>{f.title}</strong> {f.desc}</div>
              </div>
            ))}
          </div>

          <div class="card-actions">
            <a href={adhdUrl} target="_blank" rel="noopener" class="btn-primary btn-amber">
              <span>{t.products.adhd.cta}</span>
              <span>→</span>
            </a>
          </div>
        </article>

        <!-- BPD Test Card -->
        <article class="product-card" style="--card-accent: #7c3aed;">
          <div class="card-header">
            <span class="product-tag">{t.products.bpd.tag}</span>
            <span class="os-tag">{t.products.bpd.badge}</span>
          </div>

          <div class="card-identity">
            <div class="app-icon-squircle" style="background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M12 8v4"></path>
                <path d="M12 16h.01"></path>
              </svg>
            </div>
            <div>
              <h3>{t.products.bpd.title}</h3>
              <p class="product-slogan purple-slogan">{t.products.bpd.slogan}</p>
            </div>
          </div>

          <p class="product-desc">{t.products.bpd.desc}</p>

          <div class="features-list">
            {t.products.bpd.features.map(f => (
              <div class="feature-item">
                <span class="feature-icon-box">{f.icon}</span>
                <div><strong>{f.title}</strong> {f.desc}</div>
              </div>
            ))}
          </div>

          <div class="card-actions">
            <a href={bpdUrl} target="_blank" rel="noopener" class="btn-primary btn-purple">
              <span>{t.products.bpd.cta}</span>
              <span>→</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Product Matrix Technical Specs Table -->
  <SpecsTable t={t} />

  <!-- Release Radar Activity Feed -->
  <ReleaseRadar t={t} />

  <!-- Engineering & Architecture Notes -->
  <EngineeringNotes t={t} lang={lang} />

  <!-- Local-First Security Manifesto -->
  <SecurityPillars t={t} securityPageUrl={securityPageUrl} />

  <!-- Core Values -->
  <section id="values" class="values-section">
    <div class="container">
      <p class="section-label">{t.values.label}</p>
      <h2 class="section-title">{t.values.title}</h2>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">⚡</div>
          <h3>{t.values.items.speedTitle}</h3>
          <p>{t.values.items.speedDesc}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">🛡️</div>
          <h3>{t.values.items.privacyTitle}</h3>
          <p>{t.values.items.privacyDesc}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">⌨️</div>
          <h3>{t.values.items.kbdTitle}</h3>
          <p>{t.values.items.kbdDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="faq-section">
    <div class="container">
      <p class="section-label">{t.faq.label}</p>
      <h2 class="section-title">{t.faq.title}</h2>

      <div class="faq-list">
        {t.faq.items.map(item => (
          <div class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
