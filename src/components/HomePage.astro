---
import Layout from '../layouts/Layout.astro';
import { getLang, defaultLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = getLang(Astro.currentLocale) } = Astro.props;
const t = useTranslations(lang);

const dbUrl = lang === defaultLocale ? "https://db.vloam.com/" : `https://db.vloam.com/${lang}/`;
const clipUrl = lang === defaultLocale ? "https://clip.vloam.com/" : `https://clip.vloam.com/${lang}/`;
---

<Layout lang={lang}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="badge">
        <span>✦</span> {t.hero.badge}
      </div>
      <h1>{t.hero.title}</h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
    </div>
  </section>

  <!-- Products Matrix Section -->
  <section id="products" class="products-section">
    <div class="container">
      <p class="section-label">{t.nav.products}</p>
      <h2 class="section-title">The Vloam Developer Toolset</h2>

      <div class="products-grid">
        <!-- VloamDb Card -->
        <article class="product-card" style="--card-accent: #3b82f6;">
          <div class="card-header">
            <span class="product-tag">{t.dbCard.tag}</span>
            <span class="os-tag">{t.dbCard.os}</span>
          </div>
          <h3>{t.dbCard.title}</h3>
          <p class="product-slogan">{t.dbCard.slogan}</p>
          <p class="product-desc">{t.dbCard.desc}</p>

          <div class="features-list">
            <div class="feature-item">
              <span class="feature-icon">⚡</span>
              <div><strong>{t.dbCard.features.speedTitle}</strong> {t.dbCard.features.speedDesc}</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🛡️</span>
              <div><strong>{t.dbCard.features.safetyTitle}</strong> {t.dbCard.features.safetyDesc}</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">⌨️</span>
              <div><strong>{t.dbCard.features.kbdTitle}</strong> {t.dbCard.features.kbdDesc}</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🔒</span>
              <div><strong>{t.dbCard.features.privacyTitle}</strong> {t.dbCard.features.privacyDesc}</div>
            </div>
          </div>

          <div class="card-actions">
            <a href={dbUrl} target="_blank" rel="noopener" class="btn-primary">
              {t.dbCard.cta}
            </a>
            <div class="deep-links">
              <a href={`${dbUrl}features/`} target="_blank" rel="noopener">{t.dbCard.links.features}</a>
              <a href={`${dbUrl}alternatives/`} target="_blank" rel="noopener">{t.dbCard.links.alternatives}</a>
              <a href={`${dbUrl}guides/`} target="_blank" rel="noopener">{t.dbCard.links.guides}</a>
              <a href={`${dbUrl}#pricing`} target="_blank" rel="noopener">{t.dbCard.links.pricing}</a>
            </div>
          </div>
        </article>

        <!-- VloamClip Card -->
        <article class="product-card clip-card" style="--card-accent: #8b5cf6;">
          <div class="card-header">
            <span class="product-tag">{t.clipCard.tag}</span>
            <span class="os-tag">{t.clipCard.os}</span>
          </div>
          <h3>{t.clipCard.title}</h3>
          <p class="product-slogan">{t.clipCard.slogan}</p>
          <p class="product-desc">{t.clipCard.desc}</p>

          <div class="features-list">
            <div class="feature-item">
              <span class="feature-icon">📋</span>
              <div><strong>{t.clipCard.features.queueTitle}</strong> {t.clipCard.features.queueDesc}</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🔍</span>
              <div><strong>{t.clipCard.features.searchTitle}</strong> {t.clipCard.features.searchDesc}</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">⭐</span>
              <div><strong>{t.clipCard.features.favTitle}</strong> {t.clipCard.features.favDesc}</div>
            </div>
            <div class="feature-item">
              <span class="feature-icon">🔐</span>
              <div><strong>{t.clipCard.features.privacyTitle}</strong> {t.clipCard.features.privacyDesc}</div>
            </div>
          </div>

          <div class="card-actions">
            <a href={clipUrl} target="_blank" rel="noopener" class="btn-primary btn-purple">
              {t.clipCard.cta}
            </a>
            <div class="deep-links">
              <a href={`${clipUrl}features/`} target="_blank" rel="noopener">{t.clipCard.links.features}</a>
              <a href={`${clipUrl}guides/`} target="_blank" rel="noopener">{t.clipCard.links.guides}</a>
              <a href={`${clipUrl}changelog/`} target="_blank" rel="noopener">{t.clipCard.links.changelog}</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section id="values" class="values-section">
    <div class="container">
      <p class="section-label">{t.values.label}</p>
      <h2 class="section-title">{t.values.title}</h2>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">⚡</div>
          <h4>{t.values.items.speedTitle}</h4>
          <p>{t.values.items.speedDesc}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">🛡️</div>
          <h4>{t.values.items.privacyTitle}</h4>
          <p>{t.values.items.privacyDesc}</p>
        </div>

        <div class="value-card">
          <div class="value-icon">⌨️</div>
          <h4>{t.values.items.kbdTitle}</h4>
          <p>{t.values.items.kbdDesc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="faq-section">
    <div class="container">
      <p class="section-label">{t.faq.label}</p>
      <h2 class="section-title">{t.faq.title}</h2>

      <div class="faq-list">
        {t.faq.items.map(item => (
          <div class="faq-item">
            <h4>{item.q}</h4>
            <p>{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
